{
  "name": "pixardia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "verify": "pnpm env:check:example && pnpm prisma:generate && pnpm prisma:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:turbopack": "next dev --turbopack",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "test:watch": "vitest",
    "env:check:example": "node scripts/check-env.mjs --example",
    "env:check:production": "node scripts/check-env.mjs --production",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "axios": "^1.16.1",
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "pnpm": "10.34.5"
  }
}
