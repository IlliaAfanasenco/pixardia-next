# Public site configuration. NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_GITHUB_URL=""

# PostgreSQL connection used by Prisma and the contact API.
# Matches the local docker-compose.yml service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pixardia?schema=public"

# Optional distributed rate limiting. Both values are required together.
# Production must not rely on the in-memory fallback for cost-sensitive endpoints.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional AI Terminal provider settings.
# Without DEEPSEEK_API_KEY, the terminal returns its built-in fallback response.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"
